+    void CTable::WriteVerifiedLayout(NSStringUtils::CStringBuilder& writer, size_t pageIndex, size_t ordinal) const
+    {
+        auto number = [&writer](const wchar_t* key, size_t value) {
+            writer.WriteString(L" "); writer.WriteString(key); writer.WriteString(L"=\"");
+            writer.AddUInt(static_cast<unsigned int>(value)); writer.WriteString(L"\"");
+        };
+        // Native page geometry is already crop-relative, top-left millimetres.
+        auto coordinate = [&writer](const wchar_t* key, double value) {
+            writer.WriteString(L" "); writer.WriteString(key); writer.WriteString(L"=\"");
+            const long long scaled=static_cast<long long>(std::llround(value*c_dMMToPt*100000000.0));
+            writer.AddInt64(scaled/100000000);writer.WriteString(L".");
+            const std::wstring fraction=std::to_wstring(scaled%100000000);
+            writer.WriteString(std::wstring(8-fraction.size(),L'0')+fraction);writer.WriteString(L"\"");
+        };
+        writer.WriteString(L"<table"); number(L"ordinal", ordinal); number(L"pageIndex", pageIndex);
+        number(L"rows", m_nVerifiedRows); number(L"columns", m_nVerifiedCols); writer.WriteString(L">");
+        for (const auto& c : m_arVerifiedCells) {
+            writer.WriteString(L"<cell"); number(L"row", c.row); number(L"column", c.col);
+            number(L"rowSpan", c.rowSpan); number(L"columnSpan", c.colSpan);
+            coordinate(L"leftPt", c.left); coordinate(L"topPt", c.top);
+            coordinate(L"rightPt", c.right); coordinate(L"bottomPt", c.bot);
+            writer.WriteString(L"/>");
+        }
+        writer.WriteString(L"</table>");
+    }
