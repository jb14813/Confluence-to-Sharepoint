+// Defined inside NSDocxRenderer after the ordinary CPage implementation.
+// Only native already-parsed paths are replayed into the existing renderer.
+bool CPage::PrepareDerivedPdfVectors()
+{
+    auto reject=[](size_t,int){return false;};
+    // Native captures already arrive as image paints. Every surviving source
+    // vector/style paint needs a fresh Normal/no-mask/no-group proof, including
+    // nonzero paths and consumed semantic table styles.
+    for(const auto& source:m_arSourcePaints)
+        if(!source||(source->kind!=L"image"&&!source->normalComposite))return reject(source?source->id:0,__LINE__);
+    std::set<const CShape*> done;
+    for(const auto& source:m_arSourcePaints){
+        if(!source||source->fillRule!=L"evenodd")continue;
+        // Semantic table/effect ownership is retained and independently gated
+        // by the V2 consumer. Only surviving drawable figures are rendered.
+        if(source->role!=L"drawing"&&source->role!=L"cell-figure")continue;
+        const auto shape=source->output.lock();
+        if(!shape)return reject(source->id,__LINE__);
+        if(!done.insert(shape.get()).second)continue;
+        if(source->kind!=L"fill"||!source->hasSolidFill||!source->normalComposite||
+           shape->m_arSourcePaints.size()!=1||shape->m_arSourcePaints.front()!=source||
+           shape->m_eType!=CShape::eShapeType::stVectorGraphics||shape->m_pImageInfo||
+           !shape->m_arOutputObjects.empty()||!shape->m_bIsNoStroke||shape->m_bIsNoFill||
+           source->solidColor<0||source->solidColor>0xFFFFFF||source->solidAlpha<0||source->solidAlpha>255||
+           !m_oManagers.pImageManager||m_oManagers.pImageManager->m_pExternalStorage)
+            return reject(source->id,__LINE__);
+        double left=0,top=0,width=0,height=0;
+        source->originalPath.GetControlBounds(left,top,width,height);
+        CPdfDerivedVectorPlan plan;
+        if(!PdfPlanDerivedVector(left,top,width,height,plan))return reject(source->id,__LINE__);
+        const size_t bytes=static_cast<size_t>(plan.width)*plan.height*4;
+        std::unique_ptr<CBgraFrame> frame(new(std::nothrow) CBgraFrame());
+        BYTE* data=new(std::nothrow) BYTE[bytes];
+        if(!frame||!data){delete[] data;return reject(source->id,__LINE__);}
+        memset(data,0,bytes);
+        frame->put_Data(data);frame->put_Width(plan.width);frame->put_Height(plan.height);
+        const long stride=-static_cast<long>(plan.width)*4;
+        frame->put_Stride(stride);
+        std::unique_ptr<NSGraphics::IGraphicsRenderer,void(*)(NSGraphics::IGraphicsRenderer*)> renderer(
+            NSGraphics::Create(),[](NSGraphics::IGraphicsRenderer* p){if(p)p->Release();});
+        if(!renderer)return reject(source->id,__LINE__);
+        renderer->CreateFromBgraFrame(frame.get());renderer->SetSwapRGB(false);
+        renderer->put_Width(plan.widthMM);renderer->put_Height(plan.heightMM);
+        NSStructures::CBrush brush;brush.Type=c_BrushTypeSolid;brush.Color1=source->solidColor;brush.Alpha1=source->solidAlpha;
+        renderer->RestoreBrush(brush);
+        Aggplus::CMatrix shift;shift.Translate(-plan.left,-plan.top);
+        if(source->clipId){
+            if(source->clipId>m_arSourceClips.size())return reject(source->id,__LINE__);
+            const auto& originalClip=m_arSourceClips[source->clipId-1];
+            if(originalClip.id!=source->clipId||(originalClip.mode!=0&&originalClip.mode!=1))return reject(source->id,__LINE__);
+            auto clip=originalClip.path;clip.Transform(shift);
+            renderer->put_ClipMode(originalClip.mode);renderer->BeginCommand(c_nClipType);
+            clip.DrawOnRenderer(renderer.get());renderer->EndCommand(c_nClipType);
+            // CombineClip retained raster/history copies; clear only the current
+            // path so the evenOdd figure cannot include the clip contour.
+            if(renderer->PathCommandEnd()!=S_OK)return reject(source->id,__LINE__);
+        }
+        auto vector=source->originalPath;vector.Transform(shift);
+        renderer->BeginCommand(c_nPathType);vector.DrawOnRenderer(renderer.get());
+        renderer->DrawPath(c_nEvenOddFillMode);renderer->EndCommand(c_nPathType);
+        Aggplus::CImage image;image.Create(data,plan.width,plan.height,stride,true);
+        double x=plan.left,y=plan.top,w=plan.widthMM,h=plan.heightMM;
+        const auto info=m_oManagers.pImageManager->WriteImage(&image,x,y,w,h);
+        if(!info||info->m_eType!=CImageInfo::itPNG||!info->m_nId||
+           info->m_strFileName!=L"image"+std::to_wstring(info->m_nId)+L".png")return reject(source->id,__LINE__);
+        const std::wstring fileName=m_oManagers.pImageManager->m_strDstMedia+L"/"+info->m_strFileName;
+        NSFile::CFileBinary file;
+        if(!file.OpenFile(fileName)||file.GetFileSize()<=0||file.GetFileSize()>32*1024*1024)return reject(source->id,__LINE__);
+        const size_t encodedBytes=static_cast<size_t>(file.GetFileSize());file.CloseFile();
+        CImageFileFormatChecker checker;
+        if(!checker.isPngFile(fileName))return reject(source->id,__LINE__);
+        // Only the representation viewport changes; immutable source paths,
+        // bounds, source IDs, clip, paint order and cell owners remain intact.
+        CVectorGraphics viewport;
+        viewport.MoveTo(x,y);viewport.LineTo(x+w,y);viewport.LineTo(x+w,y+h);
+        viewport.LineTo(x,y+h);viewport.Close();
+        shape->SetVector(std::move(viewport));shape->m_dRotation=0;
+        shape->m_bImageFlipH=false;shape->m_bImageFlipV=false;
+        shape->m_bIsNoStroke=true;shape->m_bIsNoFill=true;
+        DrawImage(shape,info,shape->m_oVector);
+        if(m_bReconstructionFailed)return reject(source->id,__LINE__);
+        shape->m_bPdfDerivedVector=true;shape->m_nPdfDerivedWidth=plan.width;shape->m_nPdfDerivedHeight=plan.height;
+        shape->m_nPdfDerivedBytes=encodedBytes;shape->m_wsPdfDerivedResource=L"word/media/"+info->m_strFileName;
+    }
+    return true;
+}
--- a/core/DocxRenderer/src/resources/PdfDerivedVectorPlan.h
