+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <numeric>
+#include <vector>
+#include "NativeTablePrecision.h"
+
+namespace NSDocxRenderer
+{
+// This consumes only closed cells already found by CPage::BuildGraphicalCells.
+// It validates their topology; it does not discover borders or infer text columns.
+struct CNativeTableCellBounds { double left, top, right, bot; };
+struct CNativeTableCellPlacement
+{
+    size_t source, row, col, rowSpan, colSpan;
+};
+struct CNativeTableGrid
+{
+    std::vector<double> x, y;
+    std::vector<CNativeTableCellPlacement> cells;
+};
+
+inline bool BuildClosedNativeTableGrids(const std::vector<CNativeTableCellBounds>& cells,
+                                       std::vector<CNativeTableGrid>& out)
+{
+    out.clear();
+    if (cells.size() > 4096) return false;
+    std::vector<size_t> parent(cells.size());
+    std::iota(parent.begin(), parent.end(), 0);
+    auto root = [&parent](size_t i) { while (parent[i] != i) { parent[i] = parent[parent[i]]; i = parent[i]; } return i; };
+    for (const auto& c : cells)
+        if (!std::isfinite(c.left) || !std::isfinite(c.top) || !std::isfinite(c.right) || !std::isfinite(c.bot)
+                || c.left >= c.right || c.top >= c.bot) return false;
+    for (size_t i = 0; i < cells.size(); ++i)
+        for (size_t j = i + 1; j < cells.size(); ++j)
+        {
+            const auto &a = cells[i], &b = cells[j];
+            const bool xOverlap = std::max(a.left, b.left) < std::min(a.right, b.right) && !FtsNativeTableCoordinateEqual(std::max(a.left,b.left),std::min(a.right,b.right));
+            const bool yOverlap = std::max(a.top, b.top) < std::min(a.bot, b.bot) && !FtsNativeTableCoordinateEqual(std::max(a.top,b.top),std::min(a.bot,b.bot));
+            if (xOverlap && yOverlap) return false;
+            if ((xOverlap && (FtsNativeTableCoordinateEqual(a.top,b.bot) || FtsNativeTableCoordinateEqual(b.top,a.bot)))
+                    || (yOverlap && (FtsNativeTableCoordinateEqual(a.left,b.right) || FtsNativeTableCoordinateEqual(b.left,a.right)))) parent[root(j)] = root(i);
+        }
+    std::vector<std::vector<size_t>> components(cells.size());
+    for (size_t i = 0; i < cells.size(); ++i) components[root(i)].push_back(i);
+    for (const auto& component : components)
+    {
+        // A single frame has no source-proven table subdivision.
+        if (component.size() < 2) continue;
+        CNativeTableGrid grid;
+        for (size_t i : component)
+        {
+            grid.x.push_back(cells[i].left); grid.x.push_back(cells[i].right);
+            grid.y.push_back(cells[i].top); grid.y.push_back(cells[i].bot);
+        }
+        auto distinct = [](std::vector<double>& v) { std::sort(v.begin(), v.end()); v.erase(std::unique(v.begin(), v.end(), FtsNativeTableCoordinateEqual), v.end()); };
+        distinct(grid.x); distinct(grid.y);
+        if (grid.x.size() > 257 || grid.y.size() > 257 || (grid.x.size() - 1) * (grid.y.size() - 1) > 4096) return false;
+        const size_t cols = grid.x.size() - 1, rows = grid.y.size() - 1;
+        std::vector<size_t> owner(rows * cols, cells.size());
+        // The logical cuts retain an original native edge value. Equivalent
+        // machine-precision aliases share a cut; physical cell bounds below
+        // are never rewritten or averaged.
+        auto edgeIndex=[](const std::vector<double>& values,double value){
+            auto it=std::lower_bound(values.begin(),values.end(),value);
+            if(it!=values.end()&&FtsNativeTableCoordinateEqual(*it,value))return static_cast<size_t>(it-values.begin());
+            if(it!=values.begin()&&FtsNativeTableCoordinateEqual(*(it-1),value))return static_cast<size_t>(it-values.begin()-1);
+            return values.size();
+        };
+        for (size_t i : component)
+        {
+            const auto& c = cells[i];
+            const size_t col = edgeIndex(grid.x,c.left);
+            const size_t row = edgeIndex(grid.y,c.top);
+            const size_t endCol = edgeIndex(grid.x,c.right);
+            const size_t endRow = edgeIndex(grid.y,c.bot);
+            if(col>=endCol||row>=endRow||endCol>=grid.x.size()||endRow>=grid.y.size())return false;
+            for (size_t r = row; r < endRow; ++r)
+                for (size_t k = col; k < endCol; ++k)
+                {
+                    if (owner[r * cols + k] != cells.size()) return false;
+                    owner[r * cols + k] = i;
+                }
+            grid.cells.push_back({i, row, col, endRow - row, endCol - col});
+        }
+        if (std::find(owner.begin(), owner.end(), cells.size()) != owner.end()) return false;
+        std::sort(grid.cells.begin(), grid.cells.end(), [](const CNativeTableCellPlacement& a, const CNativeTableCellPlacement& b) {
+            return a.row != b.row ? a.row < b.row : a.col < b.col;
+        });
+        out.push_back(std::move(grid));
+    }
+    return true;
+}
+}
--- a/core/DocxRenderer/src/resources/NativeTablePrecision.h
+++ b/core/DocxRenderer/src/resources/NativeTablePrecision.h
@@ -0,0 +1,13 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+// Equality only for the existing native table rectangle/canonical-junction
+// predicates. Clipping's double arithmetic can leave equivalent corners a few
+// machine epsilons apart. No source point, path, bound, or center is changed.
+inline bool FtsNativeTableCoordinateEqual(double a,double b)
+{
+    return std::isfinite(a)&&std::isfinite(b)&&
+        std::fabs(a-b)<=128*std::numeric_limits<double>::epsilon()*std::max({1.0,std::fabs(a),std::fabs(b)});
+}
