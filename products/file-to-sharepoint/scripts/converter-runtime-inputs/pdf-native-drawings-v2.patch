@@ -0,0 +1,22 @@
+#pragma once
+#include <cmath>
+#include <cstddef>
+
+namespace NSDocxRenderer {
+struct CPdfDerivedVectorPlan {
+    unsigned width=0,height=0;
+    double left=0,top=0,widthMM=0,heightMM=0;
+};
+inline bool PdfPlanDerivedVector(double left,double top,double width,double height,CPdfDerivedVectorPlan& result)
+{
+    if(!std::isfinite(left)||!std::isfinite(top)||!std::isfinite(width)||!std::isfinite(height)||width<=0||height<=0)return false;
+    const double scale=192.0/25.4;
+    const double w=std::ceil(width*scale),h=std::ceil(height*scale);
+    if(!std::isfinite(w)||!std::isfinite(h)||w<1||h<1||w>4096||h>4096||w*h>8.0*1024*1024)return false;
+    const double viewportWidth=w/scale,viewportHeight=h/scale;
+    if(!std::isfinite(left+viewportWidth)||!std::isfinite(top+viewportHeight))return false;
+    result.width=static_cast<unsigned>(w);result.height=static_cast<unsigned>(h);
+    result.left=left;result.top=top;result.widthMM=viewportWidth;result.heightMM=viewportHeight;
+    return true;
+}
+}
