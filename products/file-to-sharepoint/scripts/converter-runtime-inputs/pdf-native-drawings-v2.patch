@@ -0,0 +1,47 @@
+#pragma once
+#include "VectorGraphics.h"
+#include "NativeTablePrecision.h"
+#include <set>
+#include <vector>
+
+namespace NSDocxRenderer {
+// Inspect only the established engine's CVectorGraphics::GetSubPaths output.
+// This is the same closed-axis-rectangle predicate used by the table proof.
+// The original vectors, source paints, bounds and draw order are untouched.
+inline bool FtsNativeContainedRectangles(const CVectorGraphics& vector)
+{
+    const auto parts=vector.GetSubPaths();
+    if(parts.size()<2||parts.size()>64)return false;
+    int orientation=0;bool outer=false;
+    const double left=vector.GetLeft(),top=vector.GetTop(),right=vector.GetRight(),bottom=vector.GetBottom();
+    for(const auto& part:parts){
+        std::vector<Point> points;bool closed=false;
+        for(const auto& command:part.GetData()){
+            using T=CVectorGraphics::ePathCommandType;
+            if(command.type==T::pctClose){if(closed||!command.points.empty())return false;closed=true;continue;}
+            if(closed||command.points.size()!=1)return false;
+            if(command.type==T::pctMove){if(!points.empty())return false;}
+            else if(command.type!=T::pctLine||points.empty())return false;
+            points.push_back(command.points[0]);if(points.size()>5)return false;
+        }
+        if(points.size()==5&&FtsNativeTableCoordinateEqual(points.front().x,points.back().x)&&FtsNativeTableCoordinateEqual(points.front().y,points.back().y)){points.pop_back();closed=true;}
+        if(!closed||points.size()!=4)return false;
+        const double l=part.GetLeft(),t=part.GetTop(),r=part.GetRight(),b=part.GetBottom();
+        if(!std::isfinite(l)||!std::isfinite(t)||!std::isfinite(r)||!std::isfinite(b)||l>=r||t>=b)return false;
+        std::set<unsigned> corners;
+        for(size_t i=0;i<points.size();++i){
+            const auto& p=points[i];const auto& next=points[(i+1)%points.size()];
+            const bool x=FtsNativeTableCoordinateEqual(p.x,next.x),y=FtsNativeTableCoordinateEqual(p.y,next.y);
+            if(x==y)return false;
+            const bool ll=FtsNativeTableCoordinateEqual(p.x,l),rr=FtsNativeTableCoordinateEqual(p.x,r),tt=FtsNativeTableCoordinateEqual(p.y,t),bb=FtsNativeTableCoordinateEqual(p.y,b);
+            if(ll==rr||tt==bb)return false;corners.insert((rr?1:0)+(bb?2:0));
+        }
+        if(corners.size()!=4)return false;
+        const double cross=(points[1].x-points[0].x)*(points[2].y-points[0].y)-(points[1].y-points[0].y)*(points[2].x-points[0].x);
+        if(!std::isfinite(cross)||cross==0)return false;const int sign=cross>0?1:-1;
+        if(orientation&&orientation!=sign)return false;orientation=sign;
+        if(FtsNativeTableCoordinateEqual(l,left)&&FtsNativeTableCoordinateEqual(t,top)&&FtsNativeTableCoordinateEqual(r,right)&&FtsNativeTableCoordinateEqual(b,bottom))outer=true;
+    }
+    return outer;
+}
+}
