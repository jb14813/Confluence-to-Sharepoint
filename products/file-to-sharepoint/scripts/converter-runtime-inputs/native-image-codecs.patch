+            extraCount == 1 && extraSamples && extraSamples[0] == EXTRASAMPLE_UNASSALPHA) {
+            const uint16 originalAlpha = extraSamples[0];
+            if (!straightAlpha.SelectCopyKernel(originalAlpha)) {
+                _TIFFfree(raster);
+                cx_throw("Unable to select straight-alpha TIFF decoding");
+            }
+        }
+
