+        // TIFFReadRGBAImage normally returns associated alpha, whereas
+        // CxImage and PNG store straight alpha. For original 8-bit RGB+A
+        // unassociated samples, select libTIFF's existing copy kernel. This
+        // changes only this read-only handle's temporary decoder settings;
+        // retain a local tag value and restore it on every exit before close.
+        struct StraightAlphaReadScope {
+            TIFF* image;
+            uint16 original;
+            bool restore;
+            explicit StraightAlphaReadScope(TIFF* value) : image(value), original(0), restore(false) {}
+            ~StraightAlphaReadScope() {
+                if (restore) TIFFSetField(image, TIFFTAG_EXTRASAMPLES, 1, &original);
+            }
+            bool SelectCopyKernel(uint16 value) {
+                original = value;
+                restore = true;
+                uint16 associated = EXTRASAMPLE_ASSOCALPHA;
+                return TIFFSetField(image, TIFFTAG_EXTRASAMPLES, 1, &associated) != 0;
+            }
+        } straightAlpha(m_tif);
+        uint16 extraCount = 0;
+        uint16* extraSamples = NULL;
+        TIFFGetFieldDefaulted(m_tif, TIFFTAG_EXTRASAMPLES, &extraCount, &extraSamples);
