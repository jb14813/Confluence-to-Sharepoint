+// Select existing Base14 reconstruction faces from explicit parsed PDF traits.
+// Font names and family strings are deliberately not used for inference.
+#ifndef C2S_PDF_TYPE3_FONT_PROFILE_H
+#define C2S_PDF_TYPE3_FONT_PROFILE_H
+#include <cmath>
+#include <string>
+#include "../lib/xpdf/Object.h"
+#include "../lib/xpdf/Dict.h"
+#include "../lib/xpdf/GfxFont.h"
+#include "../lib/xpdf/XRef.h"
+namespace PdfReader { namespace SemanticText {
+inline std::wstring Type3Base14Name(XRef* xref, GfxFont* font)
+{
+    bool fixed = false;
+    bool bold = false;
+    bool italic = false;
+    Object object, descriptor, value;
+    if (xref && font && font->getID())
+    {
+        const Ref* ref = font->getID();
+        xref->fetch(ref->num, ref->gen, &object);
+        if (object.isDict() && object.dictLookup("FontDescriptor", &descriptor)->isDict())
+        {
+            if (descriptor.dictLookup("Flags", &value)->isInt() && value.getInt() >= 0)
+            {
+                const int flags = value.getInt();
+                fixed = (flags & fontFixedWidth) != 0;
+                bold = (flags & fontBold) != 0 || (font && font->isBold());
+                italic = (flags & fontItalic) != 0 || (font && font->isItalic());
+            }
+            value.free();
+            if (descriptor.dictLookup("FontWeight", &value)->isNum())
+            {
+                const double weight = value.getNum();
+                // Reuse the existing native AFM reconstruction weight policy.
+                if (std::isfinite(weight) && weight >= 100 && weight <= 900 && weight >= 550)
+                    bold = true;
+            }
+            value.free();
+            if (descriptor.dictLookup("ItalicAngle", &value)->isNum())
+            {
+                const double angle = value.getNum();
+                if (std::isfinite(angle) && angle != 0) italic = true;
+            }
+            value.free();
+        }
+        descriptor.free(); object.free();
+    }
+    if (fixed)
+        return bold ? (italic ? L"Courier-BoldOblique" : L"Courier-Bold") :
+            (italic ? L"Courier-Oblique" : L"Courier");
+    return bold ? (italic ? L"Helvetica-BoldOblique" : L"Helvetica-Bold") :
+        (italic ? L"Helvetica-Oblique" : L"Helvetica");
+}
+}}
+#endif
