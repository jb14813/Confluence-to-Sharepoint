+// Preserve the existing native PDF advance only for proven axis-aligned
+// semantic Type3 reconstruction. PDF interpretation remains owned by Xpdf.
+#ifndef C2S_PDF_SEMANTIC_ADVANCE_H
+#define C2S_PDF_SEMANTIC_ADVANCE_H
+#include <cmath>
+namespace PdfReader { namespace SemanticText {
+inline bool AxisSourceAdvance(bool semanticType3, const double* rendererMatrix,
+    double startX, double startY, double endX, double endY, double& rendererWidth)
+{
+    if (!semanticType3 || !rendererMatrix) return false;
+    for (unsigned i = 0; i < 6; ++i) if (!std::isfinite(rendererMatrix[i])) return false;
+    if (!std::isfinite(startX) || !std::isfinite(startY) || !std::isfinite(endX) || !std::isfinite(endY) ||
+        rendererMatrix[0] <= 0 || rendererMatrix[3] == 0 || rendererMatrix[1] != 0 ||
+        rendererMatrix[2] != 0 || endY != startY || endX <= startX) return false;
+    // start/end were transformed through the original PDF CTM. CommandDrawText
+    // applies the normalized renderer matrix again, so invert that X scale once.
+    const double width = (endX - startX) / rendererMatrix[0];
+    if (!std::isfinite(width) || width <= 0) return false;
+    rendererWidth = width;
+    return true;
+}
+}}
+#endif
