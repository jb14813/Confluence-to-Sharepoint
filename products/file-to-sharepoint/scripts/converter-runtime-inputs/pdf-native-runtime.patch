+	bool RendererOutputDev::CheckDocxTransparencyImage(GfxState* pGState, int width, int height)
+	{
+		if (!m_pDocxTransparencyTarget) return true;
+		const double* matrix = pGState->getCTM();
+		const double sx = m_pDocxTransparencyFrame->get_Width() / pGState->getPageWidth();
+		const double sy = m_pDocxTransparencyFrame->get_Height() / pGState->getPageHeight();
+		const double displayedWidth = hypot(matrix[0] * sx, matrix[1] * sy);
+		const double displayedHeight = hypot(matrix[2] * sx, matrix[3] * sy);
+		// A bounded frame cannot preserve a raster with more source samples than
+		// displayed pixels. Refuse instead of silently reducing image detail.
+		// 1e-9 covers only floating arithmetic around an integral pixel count.
+		if (width <= 0 || height <= 0 || !std::isfinite(displayedWidth) || !std::isfinite(displayedHeight) ||
+			width > displayedWidth + 1e-9 || height > displayedHeight + 1e-9)
+		{ FailDocxTransparency(); return false; }
+		return true;
+	}
+	bool RendererOutputDev::BeginDocxTransparency(GfxState* pGState)
+	{
+		if (m_bDocxTransparencyFailed) return false;
+		if (m_pDocxTransparencyTarget) return true;
+		const double width = ceil(pGState->getPageWidth() * m_dDocxTransparencyScale);
+		const double height = ceil(pGState->getPageHeight() * m_dDocxTransparencyScale);
+		if (!std::isfinite(width) || !std::isfinite(height) || width <= 0 || height <= 0 || width > 4096 || height > 4096 || width * height > 9 * 1024 * 1024)
+		{ FailDocxTransparency(); return false; }
+		const int w = static_cast<int>(width), h = static_cast<int>(height);
+		BYTE* buffer = new(std::nothrow) BYTE[static_cast<size_t>(w) * h * 4];
+		if (!buffer) { FailDocxTransparency(); return false; }
+		memset(buffer, 0, static_cast<size_t>(w) * h * 4);
+		CBgraFrame* frame = new(std::nothrow) CBgraFrame();
+		if (!frame) { delete[] buffer; FailDocxTransparency(); return false; }
+		frame->put_Data(buffer); frame->put_Width(w); frame->put_Height(h); frame->put_Stride(-w * 4);
+		NSGraphics::IGraphicsRenderer* renderer = NSGraphics::Create();
+		if (!renderer) { delete frame; FailDocxTransparency(); return false; }
+		renderer->CreateFromBgraFrame(frame); renderer->SetSwapRGB(false); renderer->SetFontManager(m_pFontManager);
+		m_dDocxTransparencyWidthMM = PDFCoordsToMM(pGState->getPageWidth());
+		m_dDocxTransparencyHeightMM = PDFCoordsToMM(pGState->getPageHeight());
+		renderer->put_Width(m_dDocxTransparencyWidthMM); renderer->put_Height(m_dDocxTransparencyHeightMM);
+		m_bDocxTransparencyIsolated = m_bDocxTransparencyOuterEnded = false;
+		m_pDocxTransparencyTarget = m_pRenderer;
+		m_pDocxTransparencyRenderer = renderer; m_pDocxTransparencyFrame = frame;
+		m_pRenderer = renderer; m_lRendererType = c_nGrRenderer;
+		// The fresh renderer starts at identity; its transform cache must too.
+		m_arrMatrix[0] = m_arrMatrix[3] = 1; m_arrMatrix[1] = m_arrMatrix[2] = m_arrMatrix[4] = m_arrMatrix[5] = 0;
+		renderer->SetSoftMask(m_pSoftMask);
+		updateAll(pGState); UpdateAllClip(pGState);
+		return true;
+	}
+	void RendererOutputDev::FinishDocxTransparency(GfxState* pGState)
+	{
+		if (!m_pDocxTransparencyTarget || m_bDocxTransparencyFailed) return;
+		const int width = m_pDocxTransparencyFrame->get_Width(), height = m_pDocxTransparencyFrame->get_Height();
+		BYTE* pixels = m_pDocxTransparencyFrame->get_Data();
+		int left = width, right = -1, top = height, bottom = -1;
+		for (int y = 0; y < height; ++y)
+			for (int x = 0; x < width; ++x)
+				if (pixels[(static_cast<size_t>(y) * width + x) * 4 + 3])
+				{ left = std::min(left, x); right = std::max(right, x); top = std::min(top, y); bottom = std::max(bottom, y); }
+		// Only the existing graphics renderer painted these pixels; the mask's
+		// private layer was consumed by CreateSoftMask, never emitted as content.
+		IRenderer* target = m_pDocxTransparencyTarget;
+		m_pRenderer = target; m_lRendererType = c_nDocxWriter; m_pDocxTransparencyTarget = NULL;
+		// The native bitmap already contains the complete source clip. The
+		// suspended DOCX target retains an earlier clip until state is restored.
+		target->BeginCommand(c_nResetClipType);
+		target->EndCommand(c_nResetClipType);
+		target->ResetTransform();
+		m_arrMatrix[0] = m_arrMatrix[3] = 1; m_arrMatrix[1] = m_arrMatrix[2] = m_arrMatrix[4] = m_arrMatrix[5] = 0;
+		if (right >= left && bottom >= top)
+		{
+			const int w = right - left + 1, h = bottom - top + 1;
+			std::vector<BYTE> crop(static_cast<size_t>(w) * h * 4);
+			for (int y = 0; y < h; ++y)
+				memcpy(crop.data() + static_cast<size_t>(y) * w * 4, pixels + (static_cast<size_t>(top + y) * width + left) * 4, static_cast<size_t>(w) * 4);
+			Aggplus::CImage image; image.Create(crop.data(), w, h, -w * 4, true);
+			// Alpha bounds and crop bytes above use physical buffer row order.
+			// AGG's negative-stride frame starts logical top at the last row.
+			const int logicalTop = m_pDocxTransparencyFrame->get_Stride() < 0 ? height - 1 - bottom : top;
+			target->DrawImage(&image, left * m_dDocxTransparencyWidthMM / width, logicalTop * m_dDocxTransparencyHeightMM / height,
+				w * m_dDocxTransparencyWidthMM / width, h * m_dDocxTransparencyHeightMM / height);
+		}
+		RELEASEINTERFACE(m_pDocxTransparencyRenderer); RELEASEOBJECT(m_pDocxTransparencyFrame);
+		m_bDocxTransparencyIsolated = m_bDocxTransparencyOuterEnded = false;
+		if (pGState) { updateAll(pGState); UpdateAllClip(pGState); }
+	}
