{
  "manifest_version": 3,
  "name": "File to SharePoint",
  "version": "0.1.0",
  "description": "Import local documents into editable SharePoint drafts, with pictures, tables and interactive forms.",
  "minimum_chrome_version": "127",
  "homepage_url": "https://jzbapps.com",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://*.sharepoint.com/*"],
  "action": {"default_title": "File to SharePoint", "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png"}},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "background": {"service_worker":"background.js"},
  "content_scripts": [{"matches":["https://*.sharepoint.com/*"],"exclude_globs":["https://*-my.sharepoint.com/*","https://*-admin.sharepoint.com/*"],"js":["memory.js"],"run_at":"document_idle"}],
  "sandbox": {"pages":["src/engine/sandbox.html"]},
  "content_security_policy": {
    "extension_pages":"script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'",
    "sandbox":"sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'"
  }
}
