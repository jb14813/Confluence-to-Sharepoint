X2tConverter/build/Qt/X2tConverter.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile X2tConverter/build/Qt/X2tConverter.pro 'QMAKE_CXXFLAGS_RELEASE -= -O2' 'QMAKE_CXXFLAGS_RELEASE *= -Os' QMAKE_CC=emcc 'QMAKE_CFLAGS+= -sUSE_ICU=1 -sUSE_BOOST_HEADERS=0 -Os' QMAKE_CXX=em++ 'QMAKE_CXXFLAGS+= -sUSE_ICU=1 -sUSE_BOOST_HEADERS=0 -Os' QMAKE_LINK=em++ 'QMAKE_LFLAGS+=-sUSE_ICU=1 -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=128kb -sASSERTIONS=0 -sUSE_CLOSURE_COMPILER=1 -sERROR_ON_UNDEFINED_SYMBOLS=0 -sEMULATE_FUNCTION_POINTER_CASTS=1 -looxmlsignature -L/usr/local/lib --pre-js /pre-js.js -sEXPORTED_RUNTIME_METHODS=ccall,FS -sEXPORTED_FUNCTIONS=_main1 -sALLOW_MEMORY_GROWTH  -sUSE_ICU=1 -sUSE_BOOST_HEADERS=0 -Os' 'DEFINES+=__linux__ HAVE_UNISTD_H _RWSTD_NO_SETRLIMIT' 'CONFIG += staticlib' INCLUDEPATH+=/boost/libs/functional/include/

qmake_all: FORCE


all: Makefile build/bin/linux_64/x2t

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


####### Sub-libraries

check: first

benchmark: first

compiler_no_pch_compiler_make_all:
compiler_no_pch_compiler_clean:
compiler_yacc_decl_make_all:
compiler_yacc_decl_clean:
compiler_yacc_impl_make_all:
compiler_yacc_impl_clean:
compiler_lex_make_all:
compiler_lex_clean:
compiler_clean: 

