DESTDIR       = build/lib/linux_64/
TARGET        = libPdfFile.a
TARGETD       = libPdfFile.a


first: all
####### Build rules

staticlib: build/lib/linux_64/$(TARGET)

build/lib/linux_64/libPdfFile.a:  $(OBJECTS) $(OBJCOMP) 
	@test -d build/lib/linux_64/ || mkdir -p build/lib/linux_64/
	-$(DEL_FILE) build/lib/linux_64/$(TARGET)
	$(AR) $(DESTDIR)$(TARGET) $(OBJECTS)


